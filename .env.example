# ============================================================
# commerce-platform — variables de entorno
# Copia este archivo a ".env" y ajusta los valores.
#   Windows CMD/PowerShell:  copy .env.example .env
#   Git Bash / Linux/macOS:  cp .env.example .env
# ============================================================

# Puerto del HOST donde se publica PostgreSQL.
# El contenedor SIEMPRE escucha en 5432; el host usa 55432
# para no chocar con el PostgreSQL laboral (5432).
POSTGRES_PORT=55432

# Usuario de la base de datos del portfolio
POSTGRES_USER=portfolio

# Contraseña: OBLIGATORIA. Cambiala por una segura.
POSTGRES_PASSWORD=change-me-por-favor

# Nombre de la base de datos
POSTGRES_DB=commerce

# Puerto del HOST donde se publica el backend Spring Boot.
# El contenedor SIEMPRE escucha en 8080; el host usa 18080
# para no chocar con aplicaciones laborales (8080).
BACKEND_PORT=18080

# Puerto del HOST donde se publica el frontend Angular.
# El contenedor SIEMPRE escucha en 4200; el host usa 14200.
FRONTEND_PORT=14200

# Origenes permitidos para CORS (lista separada por comas).
# Debe coincidir con la URL del frontend. Nunca usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:14200
