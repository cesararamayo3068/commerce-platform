# ============================================================
# commerce-platform — .gitignore
# ============================================================

# Entorno (nunca versionar credenciales)
.env
.env.local

# IDE
.idea/
.vscode/
*.iml
.settings/
.classpath
.project

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Backend
backend/target/
backend/HELP.md

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.vite/

# Docker
# Los datos de los volumes viven en Docker, no en el repositorio.
